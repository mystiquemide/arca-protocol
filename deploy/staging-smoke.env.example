ARCA_ENV=staging
VITE_PRIVY_APP_ID=cmpijscdo00f20cjxjq3bflcp
ARCA_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
ARCA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ARCA_AUTH_REQUIRED=true
ARCA_AUTH_PROVIDER=test
ARCA_ENABLE_DEV_ENDPOINTS=true
ARCA_RATE_LIMIT_ENABLED=false
ARCA_RATE_LIMIT_BACKEND=memory
ARCA_RATE_LIMIT_GATEWAY_MANAGED=false
ARCA_ADMIN_API_TOKEN=replace_with_staging_admin_secret
ARCA_LOG_LEVEL=INFO
ARCA_LOG_REQUESTS=true

ARCA_INITIAL_RESERVE_USDC=25000
ARCA_ENFORCE_RESERVE_CAPS=false
ARCA_MIN_RESERVE_RATIO=1.5
ARCA_MAX_POLICY_PAYOUT_USDC=5000

ARCA_FLIGHTAWARE_API_KEY=replace_with_flightaware_aeroapi_key
ARCA_LOGISTICS_PROVIDER=simulation

ARCA_CIRCLE_TRANSFERS_ENABLED=false
ARCA_CIRCLE_RETRY_MAX_ATTEMPTS=3
ARCA_CIRCLE_RETRY_DELAY_SECONDS=300
ARCA_CIRCLE_RETRY_BACKOFF_MULTIPLIER=2
ARCA_CIRCLE_RETRY_MAX_DELAY_SECONDS=3600
ARCA_CIRCLE_RETRY_WORKER_ENABLED=false
ARCA_CIRCLE_RETRY_WORKER_INTERVAL_SECONDS=60
ARCA_CIRCLE_RETRY_WORKER_BATCH_SIZE=10
