# Frontend
VITE_ARCA_API_URL=http://localhost:8000
VITE_ARCA_DEMO_USER_ID=user_demo
VITE_PRIVY_APP_ID=replace_with_privy_app_id

# Backend core
ARCA_ENV=development
ARCA_DATABASE_URL=backend/data/arca.sqlite3
ARCA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication
ARCA_AUTH_REQUIRED=false
ARCA_AUTH_PROVIDER=header
ARCA_AUTH_SHARED_SECRET=replace_with_backend_api_bearer_secret
ARCA_PRIVY_APP_ID=replace_with_privy_app_id
ARCA_PRIVY_VERIFICATION_KEY=
ARCA_PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/replace_with_privy_app_id/jwks.json
ARCA_PRIVY_ISSUER=privy.io
ARCA_PRIVY_ALGORITHMS=ES256,EdDSA,RS256

# Admin, partners, and dev endpoints
ARCA_ADMIN_API_TOKEN=replace_with_32_plus_character_random_admin_secret
ARCA_ENABLE_DEV_ENDPOINTS=true
ARCA_PARTNER_API_KEYS=traveldesk_demo:replace_with_partner_api_key

# Rate limiting and logs
ARCA_RATE_LIMIT_ENABLED=false
ARCA_RATE_LIMIT_BACKEND=memory
ARCA_RATE_LIMIT_REQUESTS=120
ARCA_RATE_LIMIT_WINDOW_SECONDS=60
ARCA_RATE_LIMIT_GATEWAY_MANAGED=false
ARCA_REDIS_URL=
ARCA_LOG_LEVEL=INFO
ARCA_LOG_REQUESTS=true

# Reserve controls
ARCA_INITIAL_RESERVE_USDC=25000
ARCA_ENFORCE_RESERVE_CAPS=false
ARCA_MIN_RESERVE_RATIO=1.5
ARCA_MAX_POLICY_PAYOUT_USDC=5000

# Providers
ARCA_FLIGHTAWARE_API_KEY=replace_with_flightaware_aeroapi_key
ARCA_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&hourly=precipitation,rain,showers,weather_code&current=temperature_2m,rain,precipitation,showers,weather_code,is_day
ARCA_LOGISTICS_PROVIDER=simulation
ARCA_PROJECT44_API_KEY=
ARCA_FOURKITES_API_KEY=

# Circle payout rail
ARCA_CIRCLE_PLUGIN=circle-skills@circle
ARCA_CIRCLE_CLI_PATH=/usr/local/bin/circle
ARCA_CIRCLE_BASE_WALLET_ADDRESS=replace_with_circle_agent_base_wallet_address
ARCA_CIRCLE_TRANSFERS_ENABLED=false
ARCA_CIRCLE_RETRY_MAX_ATTEMPTS=3
ARCA_CIRCLE_RETRY_DELAY_SECONDS=300
ARCA_CIRCLE_RETRY_BACKOFF_MULTIPLIER=2
ARCA_CIRCLE_RETRY_MAX_DELAY_SECONDS=3600
ARCA_CIRCLE_RETRY_WORKER_ENABLED=false
ARCA_CIRCLE_RETRY_WORKER_INTERVAL_SECONDS=60
ARCA_CIRCLE_RETRY_WORKER_BATCH_SIZE=10

# Background sync
ARCA_WITHDRAWAL_SYNC_INTERVAL_SECONDS=60
ARCA_POLICY_SYNC_INTERVAL_SECONDS=90
